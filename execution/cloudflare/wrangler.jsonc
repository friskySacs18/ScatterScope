  },
  "durable_objects": {
    "bindings": [{"name": "ACCOUNT_ORDERS", "class_name": "AccountOrderJournal"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AccountOrderJournal"]}],
  "observability": {"enabled": true}
}
