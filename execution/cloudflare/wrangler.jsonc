{
  "name": "scope-order-executor",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "SCOPE_PRIVY_SIGNER_QUORUM_ID": "l2kx7hvbz4qd9cj9jqsdaoj5",
